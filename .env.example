# Docker Compose host ports.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Database settings for PostgreSQL and host-run development.
POSTGRES_DB=taskhub
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub_dev_password
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub_dev_password@localhost:5432/taskhub

# Development-only JWT settings. Replace JWT_SECRET_KEY for personal local use.
JWT_SECRET_KEY=replace-with-at-least-32-random-url-safe-characters
JWT_ALGORITHM=HS256

# Host-run Redis settings. Compose overrides this to use the redis service.
REDIS_URL=redis://localhost:6379/0
TASK_LIST_CACHE_TTL_SECONDS=60

# Host-run SMTP settings. Compose overrides SMTP_HOST to use Mailpit.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
